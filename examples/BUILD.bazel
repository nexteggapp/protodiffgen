load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_go//go:def.bzl", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("//bazel:defs.bzl", "proto_diff_library")

exports_files(["team.diff.textproto"])

# Writes team_diff.proto from the design's sample config.
proto_diff_library(
    name = "team_diff_proto",
    config = "team.diff.textproto",
    deps = ["//examples/example/v1:team_proto"],
)

# Keeps a copy of the generated file in the source tree, for reading. Its
# test fails when the copy is stale; bazel run updates it.
write_source_files(
    name = "write_team_diff",
    files = {"team_diff.proto": ":team_diff_proto"},
)

go_proto_library(
    name = "team_diff_go_proto",
    importpath = "example.com/team/v1/diffpb",
    proto = ":team_diff_proto",
    deps = [
        "//examples/example/v1:team_go_proto",
        "//v1:config_go_proto",
    ],
)

go_test(
    name = "example_test",
    size = "small",
    srcs = ["example_test.go"],
    deps = [
        ":team_diff_go_proto",
        "//apply",
        "//examples/example/v1:team_go_proto",
        "@org_golang_google_protobuf//proto",
    ],
)
