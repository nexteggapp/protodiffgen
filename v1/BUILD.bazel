load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

exports_files(["config.proto"])

proto_library(
    name = "config_proto",
    srcs = ["config.proto"],
    import_prefix = "nextgui.xyz/protodiffgen",
    visibility = ["//visibility:public"],
    deps = ["@protobuf//:descriptor_proto"],
)

go_proto_library(
    name = "config_go_proto",
    importpath = "github.com/nexteggapp/protodiffgen/v1",
    proto = ":config_proto",
    visibility = ["//visibility:public"],
)
