module(name = "protodiffgen")

bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_go", version = "0.62.0")
bazel_dep(name = "gazelle", version = "0.52.2")

bazel_dep(name = "bazel_lib", version = "3.7.2", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.14")

# Gazelle is used only for its go_deps extension, which makes a
# go_repository for each module in go.mod. BUILD files here are written by
# hand.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_bufbuild_protocompile", "org_golang_google_protobuf")
